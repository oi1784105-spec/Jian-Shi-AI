# 环境配置
ENV=development
PROJECT_NAME=JianShi AI
API_V1_STR=/api/v1
API_PORT=8006

# 数据库配置
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo123
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ai_interview

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6382
REDIS_PASSWORD=

# HTTP 代理配置（一般不需要开启）
USE_HTTP_PROXY=false
HTTP_PROXY=
HTTPS_PROXY=

# 邮件配置（当前未启用，保留默认即可）
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=user
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=noreply@jianshi-ai.local
MAIL_FROM_NAME=JianShi AI
MAIL_ENCRYPTION=none

# Brevo 邮件服务（当前未启用）
BREVO_API_KEY=dummy-api-key
BREVO_EMAIL_FROM=noreply@jianshi-ai.local
BREVO_EMAIL_FROM_NAME=JianShi AI

# 管理员邮箱
ADMIN_EMAIL=admin@jianshi-ai.local
ADMIN_PASSWORD=replace-with-a-strong-password

# JWT 配置
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 配置（当前未启用，使用本地存储）
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your-bucket
AWS_ENDPOINT=https://s3.amazonaws.com

# OpenAI 配置（当前未使用）
OPENAI_API_KEY=your-openai-api-key

# DeepSeek AI 配置（必填）
# 申请地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 用户 API Key 加密主密钥（使用 Fernet.generate_key() 生成，请勿提交真实值）
API_KEY_ENCRYPTION_KEY=replace-with-a-fernet-key
LITELLM_TELEMETRY=false
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
CELERY_WORKER_CONCURRENCY=2
CELERY_DEMO_TASKS_ENABLED=false
